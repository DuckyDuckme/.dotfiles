[core]
	editor = "nvim"
[init]
	defaultBranch = main
[color]
	ui = true
	status = auto
[github]
	user = DuckyDuckme
[alias]
	st = status -sb
	co = checkout
	gl = log --graph --abbrev-commit --oneline --decorate
    	gr = log --oneline --graph --decorate --branches --remotes --abbrev-commit
    	chg = log --oneline --no-merges
    	ckb = checkout -b
	br = branch
	cs = commit -s
	ca = commit -a
