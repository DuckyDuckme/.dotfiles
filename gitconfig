[core]
	editor = "nvim"
[init]
	defaultBranch = main
[alias]
	st = status -sb
	co = checkout
	gl = log --graph --oneline
    	gr = log --oneline --graph --branches --remotes
	chg = log --oneline --no-merges
    	ckb = checkout -b
	br = branch
	cs = commit -s
	ca = commit -a
