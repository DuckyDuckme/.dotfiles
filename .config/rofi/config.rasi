configuration {
	modes: "combi,filebrowser,ssh";
	show-icons: true;
	terminal: "alacritty";
	drun-show-actions: true;
	sort: true;
	sorting-method: "fzf";
	case-smart: true;
	combi-modes: "drun,run";
	matching: "fuzzy";
  timeout {
      delay:  15;
      action: "kb-cancel";
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }  
}
window{
   width: 70%;
}

@theme "/usr/share/rofi/themes/glue_pro_blue.rasi"
