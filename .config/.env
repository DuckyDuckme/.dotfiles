# Environment shared by bash and zsh. Only use syntax both shells understand
# (no zsh `path+=`, no bash-only `shopt`).
#
# thanks claude

export EDITOR=nvim
export VISUAL=nvim
export BROWSER=firefox

# prepend a directory to PATH unless it's already there, so re-sourcing doesn't duplicate it
path_prepend() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/scripts"
unset -f path_prepend
export PATH

# less / man pages
export LESS='--wordwrap -i -F --use-color --mouse --wheel-lines=5 -R'
export GROFF_NO_SGR=1   # without this, groff's own colours override LESS_TERMCAP
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'

# zoxide: print the directory after jumping
export _ZO_ECHO=1
